# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (AI) - principal
GEMINI_API_KEY=

# Respaldo 1 (opcional): proveedor OpenAI-compatible (ej. Groq)
