# Respaldo 2 (opcional): segundo proveedor OpenAI-compatible
BACKUP2_API_KEY=
BACKUP2_BASE_URL=
BACKUP2_MODEL=

# Modelo de visión para leer fotos/boletas (opcional)
VISION_MODEL=
